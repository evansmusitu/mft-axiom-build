{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["sts:GetCallerIdentity", "billing:GetCredits", "iam:GetRole", "iam:ListAttachedRolePolicies"], "Resource": "*"},
    {"Effect": "Allow", "Action": ["ec2:DescribeVpcs", "ec2:DescribeSubnets", "ec2:DescribeVpcEndpoints", "ec2:DescribeSecurityGroups", "ec2:DescribeRouteTables", "ec2:DescribeInstances"], "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}},
    {"Effect": "Deny", "NotAction": ["sts:GetCallerIdentity", "billing:GetCredits", "iam:GetRole", "iam:ListAttachedRolePolicies", "ec2:DescribeVpcs", "ec2:DescribeSubnets", "ec2:DescribeVpcEndpoints", "ec2:DescribeSecurityGroups", "ec2:DescribeRouteTables", "ec2:DescribeInstances"], "Resource": "*"},
    {"Effect": "Deny", "Action": "ec2:*", "Resource": "*", "Condition": {"StringNotEquals": {"aws:RequestedRegion": "us-east-2"}}}
  ]
}
