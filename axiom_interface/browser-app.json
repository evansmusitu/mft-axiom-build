{
  "schema": "musitu.axiom.browser-application.v1",
  "status": "PRODUCTION_DEPLOYMENT_CANDIDATE",
  "deployment": {
    "public_entry_url": "https://mftintelligence.com/axiom",
    "integration_entry_url": "https://mftintelligence.com/axiom",
    "production_app_origin": "https://app.mftintelligence.com",
    "exact_browser_entry_url": "https://app.mftintelligence.com/#/home",
    "canonical_app_path": "/",
    "default_route": "#/home",
    "entry_url": "./#/home",
    "origin_policy": "DEDICATED_APPLICATION_ORIGIN_WITH_APEX_ENTRY_BRIDGE",
    "reserved_api_origin": "https://axiom.mftintelligence.com",
    "production_deployment_claimed": false
  },
  "routing": {
    "mode": "HASH_SPA",
    "direct_deep_links": true,
    "refresh_safe": true,
    "host_navigation_fallback": "index.html",
    "legacy_index_url_normalized": true
  },
  "hosting": {
    "artifact_type": "STATIC_DIRECTORY",
    "provider": "CLOUDFLARE_WORKERS_STATIC_ASSETS",
    "application_hostname": "app.mftintelligence.com",
    "integration_routes": [
      "mftintelligence.com/axiom",
      "mftintelligence.com/axiom/*",
      "www.mftintelligence.com/axiom",
      "www.mftintelligence.com/axiom/*"
    ],
    "apex_origin_outside_integration_routes": "PRESERVED",
    "root_document": "index.html",
    "root_content_type": "text/html; charset=utf-8",
    "root_content_disposition": "inline",
    "navigation_fallback": "index.html",
    "session_cache_control": "no-store"
  },
  "edge_security": {
    "global_zone_policy": "PRESERVED",
    "browser_application_routes_configuration": {
      "scope": "DEDICATED_APP_HOST_AND_EXACT_APEX_AXIOM_PATHS_ONLY",
      "expression": "(http.host eq \"app.mftintelligence.com\") or ((http.host in {\"mftintelligence.com\" \"www.mftintelligence.com\"}) and (http.request.uri.path eq \"/axiom\" or starts_with(http.request.uri.path, \"/axiom/\")))",
      "security_level": "essentially_off",
      "browser_integrity_check": false,
      "purpose": "DIRECT_BROWSER_APPLICATION_AND_PATH_ISOLATED_ENTRY_WITHOUT_ZONE_INTERSTITIAL"
    },
    "worker_security_and_authentication_preserved": true,
    "worker_controls": [
      "SERVER_SIDE_ACTIVE_ACCOUNT_VALIDATION",
      "PER_SOURCE_AUTHENTICATION_RATE_LIMIT",
      "CSRF_VALIDATION",
      "SIGNED_SECURE_HTTP_ONLY_SESSION",
      "STRICT_CONTENT_SECURITY_POLICY",
      "RESERVED_API_ORIGIN_ISOLATION"
    ]
  },
  "session": {
    "endpoint": "./.well-known/axiom-session",
    "sign_in_path": "./auth/start",
    "sign_out_path": "./auth/sign-out",
    "account_validation": "SERVER_SIDE_CANONICAL_AXIOM_D1_ACTIVE_KEY_AND_CUSTOMER",
    "authentication_abuse_control": "CLOUDFLARE_WORKERS_RATE_LIMIT_PER_SOURCE_EDGE_LOCATION",
    "credential_transport": "HTTP_ONLY_SAME_ORIGIN_COOKIE",
    "unauthenticated_mode": "GUEST_BROWSER_WORKSPACE",
    "offline_authenticated_mode": "FAIL_CLOSED_TO_GUEST",
    "browser_token_storage": false,
    "automatic_sign_in_redirect": false
  },
  "actions": {
    "open_browser": {
      "href": "./#/home",
      "target": "_self",
      "media_type": "text/html",
      "behavior": "INLINE_BROWSER_APPLICATION_NAVIGATION",
      "download": false
    },
    "install_web_app": {
      "behavior": "BROWSER_INSTALL_PROMPT_ONLY",
      "native_binary": false
    },
    "install_android": {
      "status": "NOT_CONFIGURED_IN_VERIFIED_AXIOM_SOURCE",
      "href": null,
      "separate_from_open_browser": true
    },
    "install_ios": {
      "status": "NOT_CONFIGURED_IN_VERIFIED_AXIOM_SOURCE",
      "href": null,
      "separate_from_open_browser": true
    },
    "install_desktop": {
      "status": "NOT_CONFIGURED_IN_VERIFIED_AXIOM_SOURCE",
      "href": null,
      "separate_from_open_browser": true
    }
  }
}
