{
  "name": "mft-nexus-chatbot-20261012",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENABLE_BUSINESS_AI": "true",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "GRAPH_API_VERSION": "v25.0",
    "ENABLE_WHATSAPP_MESSAGES": "true",
    "WHATSAPP_MODE": "test",
    "ENABLE_WHATSAPP_PRODUCTION": "false"
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_BUDGET",
        "class_name": "MftAiDailyQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "mft-nexus-ai-budget-v1",
      "new_sqlite_classes": [
        "MftAiDailyQuota"
      ]
    }
  ]
}
