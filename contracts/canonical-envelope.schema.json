{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musitu.com/connect/schemas/canonical-envelope/v1",
  "title": "MUSITU Connect Canonical Envelope v1",
  "type": "object",
  "required": [
    "contract",
    "domain",
    "run_id",
    "source",
    "records"
  ],
  "properties": {
    "contract": {
      "const": "musitu.connect.canonical.v1"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
