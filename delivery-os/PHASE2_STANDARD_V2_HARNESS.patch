diff --git a/core/test/store.test.mjs b/core/test/store.test.mjs
index a3600aa..4e6b1ef 100644
--- a/core/test/store.test.mjs
+++ b/core/test/store.test.mjs
@@ -43,3 +43,71 @@ test('canonical driver availability changes are idempotent and tamper-evident',
   assert.equal(s.version, versionAfterFirst);
   assert.equal(s.evidencePack('ord-1001').chainValid, true);
 });
+
+test('canonical driver registration is idempotent and tamper-evident', () => {
+  const s = new DeliveryStore(false);
+  assert.equal(typeof s.registerDriver, 'function');
+  const input = {
+    id: 'bench-driver-01',
+    name: 'Benchmark Driver 01',
+    online: true,
+    lat: -17.83,
+    lon: 31.05,
+    capacity: 30,
+    skills: ['standard', 'refrigerated'],
+  };
+  const first = s.registerDriver(input, { eventId: 'bench:driver-register:01' });
+  assert.equal(first.created, true);
+  assert.equal(first.duplicate, false);
+  assert.deepEqual(s.drivers.get(input.id), input);
+  assert.equal(s.snapshot().events.at(-1).type, 'DRIVER_REGISTERED');
+  const versionAfterFirst = s.version;
+  const replay = s.registerDriver(input, { eventId: 'bench:driver-register:01' });
+  assert.equal(replay.duplicate, true);
+  assert.equal(s.version, versionAfterFirst);
+  assert.equal(s.snapshot().events.at(-1).hash.length, 64);
+});
+
+test('canonical traffic-delay evidence is idempotent and preserves the tamper-evident chain', () => {
+  const s = new DeliveryStore(false);
+  assert.equal(typeof s.recordTrafficDelay, 'function');
+  const first = s.recordTrafficDelay({
+    eventId: 'bench:traffic:01',
+    zone: 'zone-01',
+    delayMinutes: 20,
+    reason: 'standard-v2 deterministic disruption',
+    at: '2026-10-06T09:00:00.000Z',
+  });
+  assert.equal(first.accepted, true);
+  assert.equal(first.duplicate, false);
+  assert.equal(first.event.type, 'TRAFFIC_DELAY');
+  assert.equal(first.event.zone, 'zone-01');
+  assert.equal(first.event.delayMinutes, 20);
+  const versionAfterFirst = s.version;
+  const replay = s.recordTrafficDelay({
+    eventId: 'bench:traffic:01',
+    zone: 'zone-01',
+    delayMinutes: 20,
+    reason: 'standard-v2 deterministic disruption',
+  });
+  assert.equal(replay.duplicate, true);
+  assert.equal(s.version, versionAfterFirst);
+  assert.equal(s.snapshot().events.at(-1).hash.length, 64);
+});
+
+test('canonical driver location updates are idempotent and tamper-evident', () => {
+  const s = new DeliveryStore(false);
+  s.registerDriver({ id: 'bench-driver-01', online: true, lat: -17.83, lon: 31.05, capacity: 30, skills: ['standard'] }, { eventId: 'bench:driver-register:location' });
+  assert.equal(typeof s.setDriverLocation, 'function');
+  const first = s.setDriverLocation('bench-driver-01', { lat: -17.84, lon: 31.06 }, { eventId: 'bench:driver-location:01', at: '2026-10-06T09:00:00.000Z' });
+  assert.equal(first.changed, true);
+  assert.equal(first.duplicate, false);
+  assert.equal(s.drivers.get('bench-driver-01').lat, -17.84);
+  assert.equal(s.drivers.get('bench-driver-01').lon, 31.06);
+  assert.equal(first.event.type, 'DRIVER_LOCATION');
+  const version = s.version;
+  const replay = s.setDriverLocation('bench-driver-01', { lat: -17.84, lon: 31.06 }, { eventId: 'bench:driver-location:01' });
+  assert.equal(replay.duplicate, true);
+  assert.equal(s.version, version);
+  assert.equal(s.snapshot().events.at(-1).hash.length, 64);
+});
