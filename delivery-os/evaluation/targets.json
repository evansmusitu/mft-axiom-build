{
  "schema": "musitu-delivery-benchmark-targets.v1",
  "as_of": "2026-10-06",
  "targets": [
    {
      "provider": "onfleet",
      "access_status": "dedicated_test_organization_api_key_required",
      "official_docs": [
        "https://docs.onfleet.com/reference/introduction",
        "https://docs.onfleet.com/reference/tasks",
        "https://docs.onfleet.com/reference/routeplan",
        "https://docs.onfleet.com/reference/route-optimization",
        "https://docs.onfleet.com/reference/webhooks"
      ],
      "documented_surfaces": [
        "tasks",
        "workers",
        "route_plans",
        "route_optimization",
        "webhooks"
      ],
      "auth_probe": "GET https://onfleet.com/api/v2/auth/test",
      "required_runtime_configuration": [
        "ONFLEET_TEST_API_KEY"
      ]
    },
    {
      "provider": "bringg",
      "access_status": "own_fleet_sandbox_token_url_and_client_credentials_required",
      "official_docs": [
        "https://developers.bringg.com/v2/docs/overview",
        "https://developers.bringg.com/reference/welcome-to-bringgs-api-reference",
        "https://developers.bringg.com/reference/create_task",
        "https://developers.bringg.com/reference/api-calls",
        "https://help.bringg.com/docs/about-route-optimization-in-bringg"
      ],
      "documented_surfaces": [
        "orders_tasks",
        "driver_assignment",
        "driver_location",
        "proof_of_delivery",
        "route_optimization"
      ],
      "auth_probe": "OAuth2 client_credentials against exact Sandbox token URL",
      "required_runtime_configuration": [
        "BRINGG_SANDBOX_TOKEN_URL",
        "BRINGG_SANDBOX_CLIENT_ID",
        "BRINGG_SANDBOX_CLIENT_SECRET"
      ]
    }
  ]
}
