{
  "name": "mmf-only-local-test-fixture",
  "main": "src/testing/worker-local.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"MMF_LOCAL_ONLY": "true", "MMF_REAL_SEND_ENABLED": "false"},
