/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; media-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'
