{
 "$schema":"./node_modules/wrangler/config-schema.json",
 "name":"musitu-studio-v03",
 "main":"src/v03_entry.mjs",
 "compatibility_date":"2026-10-17",
 "workers_dev":false,
 "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
 "d1_databases":[{"binding":"STUDIO_DB","database_name":"musitu-studio-v03","database_id":"MISSING_D1_CREATE_AND_EXPLICIT_REVIEW_REQUIRED","migrations_dir":"migrations/v03"}],
 "r2_buckets":[{"binding":"STUDIO_ASSETS","bucket_name":"musitu-studio-v02-assets"}],
 "vars":{
   "ENABLE_RENDER_DISPATCH":"false",
   "BUDGET_GUARD_APPROVED":"false",
   "GPU_EXECUTION_APPROVED":"false",
   "STUDIO_V03_DAILY_CPU_LIMIT":"2",
   "STUDIO_V03_GLOBAL_ADMINS":"SET_EXACT_ACCESS_SUBS_AFTER_STAFF_ONBOARDING"
 }
}