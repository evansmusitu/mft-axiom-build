# Set only in the isolated staging secret manager. Never use Neon owner credentials.
DATABASE_URL=
INGRESS_DATABASE_URL=
APP_ORIGIN=
# Default provider is keycloak. ZITADEL requires explicitly selecting zitadel.
OIDC_PROVIDER=keycloak
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
# ZITADEL only: a separate API application in the same isolated project.
# OIDC_AUDIENCE must equal this API client ID. Secrets stay encrypted server-side.
OIDC_INTROSPECTION_CLIENT_ID=
OIDC_INTROSPECTION_CLIENT_SECRET=
SESSION_ENCRYPTION_KEY=
META_APP_SECRET=
# Protected application only. Never put the API token in the callback receiver.
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
MODEL_TOKEN=
# Protected application Preview only; never the Meta callback receiver.
# Qualification only until actual Free-plan/data controls and live cases pass.
GROQ_API_KEY=
GROQ_FREE_PLAN_VERIFIED=
AXIOM_ACCESS_TOKEN=
NEXT_TELEMETRY_DISABLED=1
META_BINDINGS_JSON=
META_DEVELOPMENT_RECIPIENTS_JSON=
PRIVACY_KEY=
PRIVACY_DEVELOPMENT_REVIEW_ENABLED=
CONTENT_ENCRYPTION_KEY=
