        "catalog_revision_before": 2,
        "catalog_revision_after": 3 if gate.endswith("PASS") else None,
        "catalog_revision3_sha256": NEW_CATALOG_SHA,
        "catalog_signature_sha256": NEW_SIG_SHA,
        "store_v102_sha256": V102_SHA,
        "store_v102_bytes": V102_BYTES,
        "store_v101_preserved": True if gate.endswith("PASS") else None,
        "store_v100_preserved": True if gate.endswith("PASS") else None,
        "chemistry_invariants_preserved": True if gate.endswith("PASS") else None,
        "phase2_authorized": False,
        "fresh_device_phase1_complete": False,
